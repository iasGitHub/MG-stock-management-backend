<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Règles essentielles du projet (volontairement restreintes) :
  lisibilité garantie sans reformattage massif du code existant.
-->
<module name="Checker">

    <!-- Pas de tabulations (indentation par espaces). -->
    <module name="FileTabCharacter"/>

    <!-- Terminaison des fichiers par un saut de ligne. -->
    <module name="NewlineAtEndOfFile"/>

    <!-- Longueur maximale des lignes. -->
    <module name="LineLength">
        <property name="max" value="140"/>
        <property name="ignorePattern" value="^package.*|^import.*|https?://"/>
    </module>

    <module name="TreeWalker">
        <!-- Imports inutilisés (Javadoc pris en compte pour ne pas fausser le résultat). -->
        <module name="UnusedImports">
            <property name="processJavadoc" value="true"/>
        </module>
    </module>

</module>
